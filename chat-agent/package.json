{
  "name": "timefold-chat-agent",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "AI SDK ToolLoopAgent for school timetabling (scoped to timefold/ APIs)",
  "scripts": {
    "dev": "node --env-file=.env ./node_modules/.bin/tsx watch src/server.ts",
    "build": "tsc",
    "start": "node --env-file=.env dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/**/*.test.ts"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^1.0.0",
    "@hono/node-server": "^1.14.0",
    "ai": "^7.0.0",
    "gray-matter": "^4.0.3",
    "hono": "^4.7.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0"
  }
}
